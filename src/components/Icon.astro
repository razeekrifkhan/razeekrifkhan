---
interface Props { name?: string; size?: number; }
const { name = 'arrow', size = 24 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'up-right' && <path d="M6 18 18 6M6 6h12v12" />}
  {name === 'construction' && <><path d="M4 21V8l8-5 8 5v13M2 21h20M8 21v-5h8v5M8 9h.01M16 9h.01M8 12h.01M16 12h.01M12 7h.01" /></>}
  {name === 'support' && <><path d="M3 16h18M5 16v-4a7 7 0 0 1 14 0v4M10 5v6m4-6v6M4 19h16" /></>}
  {name === 'hospitality' && <><path d="M3 18h18M5 15a7 7 0 0 1 14 0H5ZM12 6V4m-2 0h4M2 21h20" /></>}
  {name === 'domestic' && <><path d="m3 11 9-8 9 8M5 10v11h14V10M9 21v-7h6v7" /></>}
  {name === 'check' && <path d="m5 12 4 4L19 6" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'download' && <path d="M12 3v12m-5-5 5 5 5-5M4 17v4h16v-4" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 6 9 7 9-7"/></>}
  {name === 'chat' && <path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 10 10 0 0 1-4-.8L3 21l1.8-5A9 9 0 1 1 21 11.5Z" />}
</svg>
